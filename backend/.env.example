# ==========================================
# SocialPilot Backend Environment Configuration
# ==========================================

# PostgreSQL
# Replace YOUR_PASSWORD with the PostgreSQL password
# in your local .env file. Never commit the real password.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/socialpilot_db

# MongoDB
MONGODB_URL=mongodb://localhost:27017/
MONGODB_DB_NAME=socialpilot_db

# Application Security
# Generate a strong random value for production.
SECRET_KEY=change-this-to-a-strong-production-secret

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440